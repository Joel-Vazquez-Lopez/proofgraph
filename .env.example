# PayPal Sandbox API Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./paypal_disputes.db

# Optional AI Reasoning Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
NBE_POLICY_TYPE=heuristic

# App Server Configuration
PORT=8000
UPLOAD_DIR=./storage/uploads

# Gemini is the primary claim-analysis provider; external calls require reviewer click.
# No credential goes in NEXT_PUBLIC_* or any committed file.
AI_PROVIDER=gemini  # set to openai for the optional OpenAI path, or disabled to block
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
# Set GEMINI_API_KEY or OPENAI_API_KEY in local ignored .env / environment ONLY.
